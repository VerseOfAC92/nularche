{
  "name": "nularche",
  "version": "1.0.0",
  "private": true,
  "description": "Nularche: yerel, Markdown tabanlı kişisel bilgi yönetimi (PKM) uygulaması; Claude ile MCP üzerinden düzenleme",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:web": "vite --config packages/web/vite.config.ts",
    "build": "vite build --config packages/web/vite.config.ts",
    "build:desktop": "npm run build && node scripts/build-desktop.ts",
    "start": "node packages/server/src/index.ts",
    "desktop": "npm run build:desktop && electron .",
    "dist": "npm run build:desktop && electron-builder --publish never",
    "dist:mac": "npm run build:desktop && node scripts/dist-mac.ts",
    "dist:win": "npm run build:desktop && node scripts/dist-win.ts",
    "dist:linux": "npm run build:desktop && electron-builder --linux deb --x64 --publish never",
    "smoke:packaged": "node scripts/smoke-packaged.ts",
    "mcp": "node packages/mcp/src/index.ts",
    "mcp:smoke": "node scripts/mcp-smoke.ts",
    "test": "node --test \"packages/core/test/*.test.ts\" && vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write packages scripts",
    "connect": "node scripts/connect-ai.ts",
    "e2e": "node scripts/e2e-desktop.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tiptap/extension-code-block-lowlight": "^3.32.0",
    "@tiptap/extension-details": "^3.32.0",
    "@tiptap/extension-drag-handle-react": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extension-youtube": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.3",
    "lowlight": "^3.3.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smol-toml": "^1.9.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "author": "VerseOfAC92",
  "license": "MIT",
  "homepage": "https://github.com/VerseOfAC92/nularche",
  "repository": {
    "type": "git",
    "url": "https://github.com/VerseOfAC92/nularche.git"
  },
  "main": "dist-desktop/main.cjs",
  "productName": "Nularche",
  "bugs": {
    "url": "https://github.com/VerseOfAC92/nularche/issues"
  },
  "keywords": [
    "notes",
    "pkm",
    "markdown",
    "mcp",
    "claude",
    "electron",
    "notion-alternative"
  ],
  "dependencies": {
    "marked": "17.0.6"
  }
}
